# Copy to .env.local and fill in from your Supabase project (Settings → API).
# Only the two public values + the site URL are needed in Week 2 — picks run
# through the make_pick() RPC as the logged-in user, so no service-role key.

NEXT_PUBLIC_SUPABASE_URL="https://<your-project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<your-anon-public-key>"

# Used to build the OAuth redirect URL. Localhost in dev; your real URL in prod.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# AI verdict (Week 3) — server-only, never NEXT_PUBLIC. From openrouter.ai/keys.
OPENROUTER_API_KEY="sk-or-..."
# Comma-separated: first is primary, the rest are fallbacks when it's busy.
# Defaults to these free models if unset. Paid (non-":free") models are blocked
# unless OPENROUTER_ALLOW_PAID="true".
OPENROUTER_MODEL="nvidia/nemotron-3-super-120b-a12b:free,apodex/apodex-1.1-mini:free"
